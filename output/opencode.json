{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "sensai-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sensai Ollama 근거 피어",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5-9B Ollama 로컬 모델"
        }
      }
    }
  },
  "model": "zai/glm-5.2",
  "small_model": "sensai-ollama/qwen3.5:9b",
  "default_agent": "sensai-analysis-lead",
  "share": "disabled",
  "autoupdate": false,
  "subagent_depth": 1,
  "watcher": {
    "ignore": [
      ".git/**",
      ".omo/**",
      "docs/analysis/missions/**/.sensai-tmp/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "compaction": {
      "model": "zai/glm-5.2"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*id_rsa*": "deny",
      "*credentials*": "deny",
      "*secrets.*": "deny",
      "auth.json": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/auth.json": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.config/opencode/**": "deny",
      "**/.local/share/opencode/**": "deny"
    },
    "edit": {
      "*": "deny",
      "docs/analysis/missions/**": "allow",
      "**/../**": "deny"
    },
    "bash": {
      "*": "deny",
      "fd": "allow",
      "fd *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "sg": "allow",
      "sg *": "allow",
      "jq": "allow",
      "jq *": "allow",
      "yq": "allow",
      "yq *": "allow",
      "mdq": "allow",
      "mdq *": "allow",
      "mmdc": "allow",
      "mmdc *": "allow",
      "\"$HOME/.local/bin/sensai\" mission init *": "allow",
      "\"$HOME/.local/bin/sensai\" mission checkpoint *": "allow",
      "\"$HOME/.local/bin/sensai\" mission resume *": "allow",
      "\"$HOME/.local/bin/sensai\" mission status *": "allow",
      "codegraph --version": "allow",
      "codegraph status . --json": "allow",
      "codegraph query --path . --limit 1 --json '*'": "allow",
      "codegraph query --path . --limit 2 --json '*'": "allow",
      "codegraph query --path . --limit 3 --json '*'": "allow",
      "codegraph query --path . --limit 4 --json '*'": "allow",
      "codegraph query --path . --limit 5 --json '*'": "allow",
      "codegraph query --path . --limit 6 --json '*'": "allow",
      "codegraph query --path . --limit 7 --json '*'": "allow",
      "codegraph query --path . --limit 8 --json '*'": "allow",
      "codegraph query --path . --limit 9 --json '*'": "allow",
      "codegraph query --path . --limit 10 --json '*'": "allow",
      "codegraph explore --path . --max-files 1 '*'": "allow",
      "codegraph explore --path . --max-files 2 '*'": "allow",
      "codegraph explore --path . --max-files 3 '*'": "allow",
      "codegraph explore --path . --max-files 4 '*'": "allow",
      "codegraph explore --path . --max-files 5 '*'": "allow",
      "codegraph explore --path . --max-files 6 '*'": "allow",
      "codegraph explore --path . --max-files 7 '*'": "allow",
      "codegraph explore --path . --max-files 8 '*'": "allow",
      "codegraph node --path . '*'": "allow",
      "codegraph callers --path . --limit 1 --json '*'": "allow",
      "codegraph callers --path . --limit 2 --json '*'": "allow",
      "codegraph callers --path . --limit 3 --json '*'": "allow",
      "codegraph callers --path . --limit 4 --json '*'": "allow",
      "codegraph callers --path . --limit 5 --json '*'": "allow",
      "codegraph callers --path . --limit 6 --json '*'": "allow",
      "codegraph callers --path . --limit 7 --json '*'": "allow",
      "codegraph callers --path . --limit 8 --json '*'": "allow",
      "codegraph callers --path . --limit 9 --json '*'": "allow",
      "codegraph callers --path . --limit 10 --json '*'": "allow",
      "codegraph callers --path . --limit 11 --json '*'": "allow",
      "codegraph callers --path . --limit 12 --json '*'": "allow",
      "codegraph callers --path . --limit 13 --json '*'": "allow",
      "codegraph callers --path . --limit 14 --json '*'": "allow",
      "codegraph callers --path . --limit 15 --json '*'": "allow",
      "codegraph callers --path . --limit 16 --json '*'": "allow",
      "codegraph callers --path . --limit 17 --json '*'": "allow",
      "codegraph callers --path . --limit 18 --json '*'": "allow",
      "codegraph callers --path . --limit 19 --json '*'": "allow",
      "codegraph callers --path . --limit 20 --json '*'": "allow",
      "codegraph impact --path . --depth 1 --json '*'": "allow",
      "codegraph impact --path . --depth 2 --json '*'": "allow",
      "codegraph impact --path . --depth 3 --json '*'": "allow",
      "codegraph *' *'*": "deny",
      "codegraph serve *": "deny",
      "codegraph init *": "deny",
      "codegraph index *": "deny",
      "codegraph sync *": "deny",
      "codegraph uninit *": "deny",
      "codegraph install*": "deny",
      "codegraph upgrade*": "deny",
      "codegraph *$*": "deny",
      "codegraph *\t*": "deny",
      "codegraph *\r*": "deny",
      "codegraph *\"*": "deny",
      "codegraph *'*'*'*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*`*": "deny",
      "*$(*": "deny",
      "*\n*": "deny",
      "*;*": "deny",
      "*&*": "deny",
      "*&&*": "deny",
      "*||*": "deny",
      "fd *--exec*": "deny",
      "fd *-x*": "deny",
      "fd *-X*": "deny",
      "rg *--pre*": "deny",
      "sg *--rewrite*": "deny",
      "sg *-r*": "deny",
      "sg *--update-all*": "deny",
      "yq *-i*": "deny",
      "yq *--inplace*": "deny",
      "**.env*": "deny",
      "**.pem*": "deny",
      "**id_rsa*": "deny",
      "**credentials*": "deny",
      "**secrets.*": "deny",
      "**/auth.json*": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.config/opencode/**": "deny",
      "**/.local/share/opencode/**": "deny"
    },
    "task": {
      "*": "deny",
      "sensai-evidence-peer": "allow"
    },
    "skill": {
      "*": "deny",
      "sensai-business-trace": "allow",
      "sensai-checklist": "allow",
      "sensai-convention-extract": "allow",
      "sensai-evidence-first": "allow",
      "sensai-mermaid-sequence": "allow",
      "sensai-react-trace": "allow",
      "sensai-spec-evidence": "allow",
      "sensai-stack-discovery": "allow",
      "sensai-ui-definition": "allow",
      "sensai-vertx-trace": "allow"
    },
    "codegraph_*": "deny",
    "codegraph_explore": "ask",
    "external_directory": "deny",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "doom_loop": "deny"
  }
}
